# Copy to .env (gitignored) and fill in. NEVER commit .env.
# All values from the Supabase dashboard of the project you target.

# Project ref (the subdomain, e.g. tgwzetudfoitxdjviavc)
SUPABASE_PROJECT_REF=

# Project API URL → https://<ref>.supabase.co
SUPABASE_URL=

# Service role / secret key (Dashboard → Project Settings → API keys).
# Secret — used only server-side by the ingestors. Never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for DDL + ingest (Dashboard → Project Settings → Database → Connection string).
# Use the DIRECT / Session connection (port 5432) for migrations, not the transaction pooler.
SUPABASE_DB_URL=

# Optional: Personal Access Token for the CLI if you don't use `supabase login`
# (Dashboard → Account → Access Tokens).
SUPABASE_ACCESS_TOKEN=

# Read-only connection used by the MCP serving layer (SELECT-only role civic_serve,
# + INSERT/UPDATE solo sulle 2 tabelle di revisione). Generated by `npm run setup:readonly` — do not set by hand.
SUPABASE_DB_URL_READONLY=

# Bearer token che protegge l'intero endpoint /mcp del server HTTP (mcp/http.ts → Railway).
# Generare con `openssl rand -hex 32`. Se vuoto, l'endpoint è aperto (solo dev locale).
MCP_AUTH_TOKEN=

# Porta del server HTTP MCP (mcp/http.ts). Default 3000; su Railway la imposta la piattaforma.
PORT=

# --- Scope degli ingestori (opzionali: vuoti = pilota Lombardia) ---

# 'national' → ingestors/bilancio.ts scarica i rendiconti BDAP di tutte le regioni (anno 2024).
BDAP_SCOPE=

# Regioni custom per bilancio.ts, separate da '|' (es. 'Lombardia|Veneto'). Vince su BDAP_SCOPE.
BDAP_REGIONI=

# Anni custom per bilancio.ts, separati da ',' (es. '2023,2024'). Vince su tutto.
BDAP_YEARS=

# 'national' → ingestors/opencoesione.ts scarica il bulk nazionale invece del regionale Lombardia.
COESIONE_SCOPE=

# URL bulk OpenCoesione esplicito (override totale, es. un altro ciclo o un'altra regione).
COESIONE_URL=

# SNAP: data snapshot della run (YYYY-MM-DD). Default: oggi (UTC). Impostare solo per ri-registrare una data specifica.
# SNAP=2026-06-29
